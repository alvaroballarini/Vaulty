generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 1. USUARIOS Y AUTENTICACIÓN
model User {
  id            String         @id @default(cuid()) // Mejor que integer
  email         String         @unique
  password      String         @unique
  name          String?
  accounts      Account[]
  categories    Category[]
  transactions  Transaction[]
  notifications Notification[]
  budgets       Budget[]
  createdAt     DateTime       @default(now())
  productTourSeenAt DateTime?

  recurringTransactions RecurringTransaction[]
  sessions              Session[]
}

model Session {
  id String @id @default(cuid())

  token String @unique

  expiresAt DateTime

  userId String

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  userAgent String?

  ip String?

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
}

// 2. CUENTAS (Bancos, Tarjetas, Efectivo) -> ¡Nueva y vital!
model Account {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  type         AccountType
  transactions Transaction[]

  recurringTransactions RecurringTransaction[]

  @@index([userId, type])
}

// 3. CATEGORÍAS (Con UI helpers)
model Category {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  type         TransactionType
  icon         String
  color        String
  transactions Transaction[]
  budgets      Budget[]

  recurringTransactions RecurringTransaction[]

  @@index([userId, type])
}

model RecurringTransaction {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id])

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  description    String
  expectedAmount Decimal         @db.Decimal(12, 2)
  type           TransactionType

  frequency Frequency @default(MONTHLY)

  dayOfWeek  DayOfWeek?
  dayOfMonth Int?
  time       String?

  nextRunAt DateTime?
  lastRunAt DateTime?

  isActive Boolean @default(true)

  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, nextRunAt])
  @@index([userId])
  @@index([accountId])
  @@index([categoryId])
}

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title   String // Ej: "¡Presupuesto excedido!"
  message String // Ej: "Has superado el 90% de tu presupuesto en Supermercado."
  type    NotificationType
  isRead  Boolean          @default(false)
  link    String? // URL interna para redirigir al hacer clic (ej: "/dashboard/budgets")

  createdAt DateTime  @default(now())
  readAt    DateTime? // Auditoría: cuándo la abrió el usuario

  // ⚡ ÍNDICE CRÍTICO PARA RENDIMIENTO EN PRODUCCIÓN
  @@index([userId, isRead])
}

enum NotificationType {
  BUDGET_WARNING // Presupuesto cerca del límite o superado
  ACTION_PROG // Presupuesto cerca del límite o superado
  RECURRING_DUE // Próximo vencimiento de un gasto fijo o sueldo
  GOAL_ACHIEVED // Meta de ahorro alcanzada
  SYSTEM // Avisos del sistema / mantenimiento
}

// 2. ACTUALIZAMOS LA TABLA TRANSACTION (Para vincular si vino de un gasto fijo/sueldo)
model Transaction {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id])

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  recurringTransactionId String?
  recurringTransaction   RecurringTransaction? @relation(fields: [recurringTransactionId], references: [id])

  amount      Decimal         @db.Decimal(12, 2)
  type        TransactionType
  description String?
  date        DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
  @@index([userId, type, date])
  @@index([userId, categoryId, date])
  @@index([accountId, date])
  @@index([categoryId, date])
  @@index([recurringTransactionId])
}

// 5. PRESUPUESTOS (Atados a categoría y tiempo)
model Budget {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  amount Decimal @db.Decimal(12, 2)
  month  Int // 1-12
  year   Int // Ej: 2026

  @@unique([userId, categoryId, year, month])
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum AccountType {
  BANK
  CASH
  CREDIT
}

enum Frequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}
